# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Flask Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# CORS Configuration
CORS_ORIGIN=*

# reCAPTCHA v2 Configuration
# Use your own Google reCAPTCHA v2 site key and secret key.
# If you do not set RECAPTCHA_SECRET_KEY, verification is skipped.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_PUBLIC_KEY=

# reCAPTCHA Scoring Threshold (v3 only, not used for v2)
RECAPTCHA_THRESHOLD=0.5
